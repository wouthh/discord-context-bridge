{
  "name": "discord-context-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-plugin.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "privacy": "node scripts/privacy-check.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run privacy",
    "start": "node dist/packages/service/src/main.js",
    "bot": "node dist/packages/bot/src/main.js",
    "setup": "tsx packages/service/src/setup.ts",
    "control": "tsx packages/service/src/control.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "better-sqlite3": "13.0.3",
    "discord.js": "14.27.0",
    "express": "5.2.1",
    "jose": "6.2.12",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
